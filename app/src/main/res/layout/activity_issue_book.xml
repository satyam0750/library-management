<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F6FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Issue Book"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F3C88"
        android:layout_marginBottom="20dp"/>

    <!-- Book ID Scan Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etBookId"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Book Accession No / Barcode"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:inputType="text"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/btnScanBook"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/id_badge_bg"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@android:color/white"
            android:contentDescription="Scan Book Barcode" />
    </LinearLayout>

    <!-- Student ID Scan Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMemberId"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Student ID (e.g. STU-0001)"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:inputType="text"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/btnScanStudent"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/id_badge_bg"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@android:color/white"
            android:contentDescription="Scan Student QR" />
    </LinearLayout>

    <EditText
        android:id="@+id/etDate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Issue Date (YYYY-MM-DD)"
        android:textColor="#000000"
        android:textColorHint="#757575"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="20dp"
        android:inputType="date"
        android:importantForAutofill="no"/>

    <Button
        android:id="@+id/btnIssueBook"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Issue Book"
        android:textColor="@android:color/white"
        android:backgroundTint="#1F3C88"/>

</LinearLayout>
